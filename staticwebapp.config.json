{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/images/*", "/css/*", "/js/*", "*.{png,jpg,jpeg,gif,svg,webp,css,js,ico,txt,xml,webmanifest}"]
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    {
      "route": "/web-development",
      "redirect": "/services/web-development/",
      "statusCode": 301
    },
    {
      "route": "/web-development/*",
      "redirect": "/services/web-development/",
      "statusCode": 301
    },
    {
      "route": "/wordpress-development",
      "redirect": "/services/wordpress-development/",
      "statusCode": 301
    },
    {
      "route": "/wordpress-development/*",
      "redirect": "/services/wordpress-development/",
      "statusCode": 301
    },
    {
      "route": "/woocommerce-development",
      "redirect": "/services/woocommerce-development/",
      "statusCode": 301
    },
    {
      "route": "/woocommerce-development/*",
      "redirect": "/services/woocommerce-development/",
      "statusCode": 301
    },
    {
      "route": "/react-development",
      "redirect": "/services/react-development/",
      "statusCode": 301
    },
    {
      "route": "/react-development/*",
      "redirect": "/services/react-development/",
      "statusCode": 301
    },
    {
      "route": "/nextjs-development",
      "redirect": "/services/nextjs-development/",
      "statusCode": 301
    },
    {
      "route": "/nextjs-development/*",
      "redirect": "/services/nextjs-development/",
      "statusCode": 301
    },
    {
      "route": "/seo-services",
      "redirect": "/services/seo-services/",
      "statusCode": 301
    },
    {
      "route": "/seo-services/*",
      "redirect": "/services/seo-services/",
      "statusCode": 301
    },
    {
      "route": "/ui-ux-design",
      "redirect": "/services/ui-ux-design/",
      "statusCode": 301
    },
    {
      "route": "/ui-ux-design/*",
      "redirect": "/services/ui-ux-design/",
      "statusCode": 301
    },
    {
      "route": "/website-performance",
      "redirect": "/services/website-performance/",
      "statusCode": 301
    },
    {
      "route": "/website-performance/*",
      "redirect": "/services/website-performance/",
      "statusCode": 301
    },
    {
      "route": "/images/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/css/*",
      "headers": {
        "cache-control": "public, max-age=604800, stale-while-revalidate=86400"
      }
    },
    {
      "route": "/js/*",
      "headers": {
        "cache-control": "public, max-age=604800, stale-while-revalidate=86400"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  }
}
